name: acute_malnutrition_chap

uv_env: pyproject.toml
supported_period_type: month
target: disease_cases

min_prediction_length: 1
max_prediction_length: 3

required_covariates:
  - mean_temperature
  - rainfall
  - mean_relative_humidity
  - average_gpp
  - malaria_confirmed
  - pneumonia_cases
  - pregnant_women_with_Anaemia
  - diarrhea_acute
  - low_birth_weight_babies
  - diarrhea_persistent
  - population

entry_points:
  train:
    parameters:
      train_data: str
      model: str
    command: "python train.py {train_data} {model}"
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file}"

meta_data:
  display_name: "Acute Malnutrition Forecasting Tool"
  description: >
    Monthly district-level acute malnutrition forecasting model prepared for
    DHIS2 CHAP integration. The model consumes CHAP-format case-count and
    covariate data and returns probabilistic forecasts as sample columns.
  author: "HISP Uganda"
  author_assessed_status: orange
  documentation_url: "https://github.com/omielp/acute-malnutrition-RF-model"
